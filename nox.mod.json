{
  "type": "mod",
  "id": "nox.sessions",
  "provides": [
    "session"
  ],
  "name": "Sessions",
  "version": "1.0.x",
  "description": "Session lifecycle management, joining, and player synchronization.",
  "license": "GPL-3.0",
  "icon": null,
  "contact": {
    "email": "hactazia@gmail.com",
    "source": "https://github.com/AtelierVR/api.nox.session",
    "website": "https://nox.hactazia.fr/",
    "issues": "https://github.com/AtelierVR/api.nox.session/issues"
  },
  "authors": [
    {
      "name": "Hactazia",
      "email": "hactazia@gmail.com",
      "website": "https://hactazia.fr/"
    }
  ],
  "relations": [
    {
      "id": "ui",
      "type": "depends",
      "register": "git+https://github.com/AtelierVR/nox.ui.git"
    },
    {
      "id": "terminal",
      "type": "depends",
      "register": "git+https://github.com/AtelierVR/nox.terminal.git"
    },
    {
      "id": "players",
      "type": "depends",
      "register": "git+https://github.com/AtelierVR/nox.players.git"
    },
    {
      "id": "avatars",
      "type": "depends",
      "register": "git+https://github.com/AtelierVR/nox.avatars.git"
    },
    {
      "id": "entity",
      "type": "depends",
      "register": "git+https://github.com/AtelierVR/nox.entities.git"
    },
    {
      "id": "settings",
      "type": "depends",
      "register": "git+https://github.com/AtelierVR/nox.settings.git"
    },
    {
      "id": "servers",
      "type": "depends",
      "register": "git+https://github.com/AtelierVR/nox.servers.git"
    },
    {
      "id": "scripting",
      "type": "depends",
      "register": "git+https://github.com/AtelierVR/nox.scripting.git"
    },
    {
      "id": "com.unity.modules.uielements",
      "type": "depends",
      "register": "upm+com.unity.modules.uielements@1.0.0"
    },
    {
      "id": "com.unity.modules.ui",
      "type": "depends",
      "register": "upm+com.unity.modules.ui@1.0.0"
    }
  ],
  "constraints": [
    {
      "type": "after",
      "id": "settings"
    },
    {
      "type": "after",
      "id": "terminal"
    }
  ],
  "entrypoints": {
    "main": [
      "Nox.Sessions.Runtime.Main"
    ],
    "editor": [
      "Nox.Sessions.Runtime.Editor.SessionsPanel",
      "Nox.Sessions.Runtime.Editor.SessionDetailsPanel",
      "Nox.Sessions.Runtime.Editor.PlayerPanel"
    ],
    "client": [
      "Nox.Sessions.Clients.Client"
    ]
  }
}